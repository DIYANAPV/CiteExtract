# CiteExtract Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to git — it contains secrets.

# --- API Keys (secrets) ---

# OpenAI — required for Full mode (L4 semantic) and Agentic mode
OPENAI_API_KEY=

# Semantic Scholar — optional, increases rate limit from 1 req/s to 10 req/s
# Get one at: https://www.semanticscholar.org/product/api#api-key
S2_API_KEY=

# SerpAPI — optional, enables Google Scholar verification for false-positive prevention
# Free tier: 100 searches/month. Get one at: https://serpapi.com/
SERPAPI_KEY=

# --- Polite Pool Emails ---
# CrossRef and OpenAlex give higher rate limits if you identify yourself.
# Use your real email to access the "polite pool".
# CrossRef: 50 req/s (polite) vs 1 req/s (anonymous)
# OpenAlex: 10 req/s (polite) vs 1 req/s (anonymous)

CROSSREF_MAILTO=citeextract@example.com
OPENALEX_MAILTO=citeextract@example.com
