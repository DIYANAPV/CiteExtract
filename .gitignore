# Outer-repo gitignore. Production product lives in citeextract/ and has its own .gitignore.

# Experiment whitelist (only commit experiment/paper/)
experiment/*
!experiment/paper/
!experiment/paper/**
experiment/paper/**/__pycache__/

# Heavy reproducible artefacts: kept locally, regenerated by scripts, included
# in the supplementary release via experiment/paper/make_release.sh.
experiment/paper/results/
experiment/paper/prevalence/data/papers/

Paper/*
# Python build artefacts
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# IDE
.vscode/
.idea/

# Pytest
.pytest_cache/

# Trash
*.pre_recovery


# Logs (debug traces, not reproducible/load-bearing for results)
*.log

# Local API cache (regenerated on first run)
data/cache/

# OS
.DS_Store
Thumbs.db
